{
  "requestTimeoutSeconds": 60,
  "adapterMode": true,
  "mcpServers": {
    "test-stdio": {
      "name": "Test STDIO",
      "enabled": true,
      "transport": "stdio",
      "command": "__TEST_MCP_SERVER_COMMAND__",
      "args": ["--capabilities", "tools"]
    },
    "test-http": {
      "name": "Test Streamable HTTP",
      "enabled": true,
      "transport": "http",
      "url": "__TEST_MCP_SERVER_HTTP_URL__"
    },
    "test-sse": {
      "name": "Test HTTP SSE",
      "enabled": true,
      "transport": "sse",
      "url": "__TEST_MCP_SERVER_SSE_URL__"
    }
  }
}
