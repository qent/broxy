      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "name": "io.qent.broxy/github",
      "title": "GitHub Copilot MCP",
      "description": "GitHub remote MCP endpoint for Copilot-compatible clients.",
      "version": "latest",
      "websiteUrl": "https://docs.github.com/en/copilot/how-tos/provide-context/use-mcp/extend-copilot-chat-with-mcp",
      "icons": [
        {
          "src": "https://raw.githubusercontent.com/qent/broxy-registry/main/icons/github.png",
          "mimeType": "image/png",
          "sizes": [
            "64x64"
          ]
        }
      ],
      "remotes": [
        {
          "type": "streamable-http",
          "url": "https://api.githubcopilot.com/mcp/",
          "headers": [
            {
              "name": "Authorization",
              "description": "GitHub PAT for Copilot MCP endpoint.",
              "value": "Bearer {github_pat}",
              "isRequired": true,
              "isSecret": true,
              "variables": {
                "github_pat": {
                  "description": "GitHub Personal Access Token.",
                  "isRequired": true,
                  "isSecret": true
                }
              }
            }
          ]
        }
      ],
      "_meta": {
        "io.qent.broxy/catalog": {
          "capabilities": [
            "tools",
            "resources"
          ]
        }
      }
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "name": "io.qent.broxy/intellij-idea-ce",
      "title": "IntelliJ IDEA CE",
      "description": "Connect to local IntelliJ MCP server over SSE.",
      "version": "2026.1",
      "websiteUrl": "https://www.jetbrains.com/help/idea/mcp-server.html",
      "repository": {
        "source": "npm",
        "url": "https://www.npmjs.com/package/@jetbrains/mcp-proxy"
      },
      "icons": [
        {
          "src": "https://raw.githubusercontent.com/qent/broxy-registry/main/icons/intellij-idea-ce.png",
          "mimeType": "image/png",
          "sizes": [
            "64x64"
          ]
        }
      ],
      "remotes": [
        {
          "type": "sse",
          "url": "http://localhost:64343/sse",
          "headers": [
            {
              "name": "IJ_MCP_SERVER_PROJECT_PATH",
              "description": "Absolute path to the project opened in IntelliJ IDEA.",
              "value": "{project_path}",
              "isRequired": true,
              "isSecret": false,
              "variables": {
                "project_path": {
                  "description": "Absolute project path for IntelliJ MCP context.",
                  "format": "filepath",
                  "placeholder": "/Users/you/Repos/project",
                  "isRequired": true
                }
              }
            }
          ]
        }
      ],
      "_meta": {
        "io.qent.broxy/catalog": {
          "capabilities": [
            "tools",
            "resources"
          ]
        }
      }
    },
