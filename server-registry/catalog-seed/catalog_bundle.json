    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "name": "io.qent.broxy/brave",
      "title": "Brave Search",
      "description": "Web and local search powered by Brave Search API.",
      "version": "0.6.2",
      "websiteUrl": "https://brave.com/search/api/",
      "repository": {
        "source": "github",
        "url": "https://github.com/modelcontextprotocol/servers-archived",
        "subfolder": "src/brave-search"
      },
      "icons": [
        {
          "src": "https://raw.githubusercontent.com/qent/broxy-registry/main/icons/brave.png",
          "mimeType": "image/png",
          "sizes": [
            "64x64"
          ]
        }
      ],
      "packages": [
        {
          "registryType": "oci",
          "identifier": "docker.io/mcp/brave-search",
          "version": "0.6.2",
          "runtimeHint": "docker",
          "transport": {
            "type": "stdio"
          },
          "runtimeArguments": [
            {
              "type": "positional",
              "value": "run"
            },
            {
              "type": "positional",
              "value": "-i"
            },
            {
              "type": "positional",
              "value": "--rm"
            },
            {
              "type": "positional",
              "value": "-e"
            },
            {
              "type": "positional",
              "value": "BRAVE_API_KEY"
            }
          ],
          "environmentVariables": [
            {
              "name": "BRAVE_API_KEY",
              "description": "Brave Search API key.",
              "isRequired": true,
              "isSecret": true
            }
          ]
        }
      ],
      "_meta": {
        "io.qent.broxy/catalog": {
          "capabilities": [
            "tools"
          ]
        }
      }
    },
    {
      "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
      "name": "io.qent.broxy/context7",
      "title": "Context7",
      "description": "Up-to-date code and API docs for prompts.",
      "version": "2.1.6",
      "websiteUrl": "https://context7.com",
      "repository": {
        "source": "github",
        "url": "https://github.com/upstash/context7"
      },
      "icons": [
        {
          "src": "https://raw.githubusercontent.com/qent/broxy-registry/main/icons/context7.png",
          "mimeType": "image/png",
          "sizes": [
            "64x64"
          ]
        }
      ],
      "remotes": [
        {
          "type": "streamable-http",
          "url": "https://mcp.context7.com/mcp",
          "headers": [
            {
              "name": "CONTEXT7_API_KEY",
              "description": "Optional Context7 API key for authenticated access.",
              "value": "{context7_api_key}",
              "isRequired": false,
              "isSecret": true,
              "variables": {
                "context7_api_key": {
                  "description": "Context7 API key.",
                  "isRequired": false,
                  "isSecret": true
                }
              }
            }
          ]
        }
      ],
      "_meta": {
        "install_steps": [
          "Open your **GitHub** [Developer Settings](https://github.com/settings/apps).",
          "Select [Tokens (classic)](https://github.com/settings/tokens) from **Personal access tokens**.",
          "Click [Generate new token (classic)](https://github.com/settings/tokens/new) from **Generate new token** selector.",
          "Fill **New personal access token (classic)** form and submit with the **Generate token** button.",
          "Use created token below [Authorization]"
        ],
        "io.qent.broxy/catalog": {
          "capabilities": [
            "tools",
            "resources"
          ]
        }
      }
    },
